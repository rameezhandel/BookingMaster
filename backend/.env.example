# ---------------------------------------------------------------- required --

# Postgres connection string.
#
# IMPORTANT: this role must NOT be a superuser and must not have BYPASSRLS.
# Either bypasses row-level security silently — the policies exist, `\d` shows
# them, and tenants are not isolated. The app refuses to start in production if
# the role it connects as can bypass them.
DATABASE_URL=postgres://bookingmaster:bookingmaster@localhost:5432/bookingmaster

# Signing key for owner session tokens.
# Generate one with:  openssl rand -hex 32
# The app refuses to start in production if this is the example value or is
# shorter than 32 characters.
JWT_SECRET=change-me-in-production

# ---------------------------------------------------------------- optional --

NODE_ENV=development
PORT=3000
JWT_EXPIRES_IN=7d

# Only needed when the web app is served from a different origin, i.e. the Vite
# dev server. In production the API serves the bundle itself and this stays unset.
CORS_ORIGIN=http://localhost:5173

# Set to true ONLY when running behind a reverse proxy or PaaS router, so rate
# limiting sees the real client IP. Leave off otherwise: trusting the header
# without a proxy in front lets clients forge their own address.
TRUST_PROXY=false

# Override where the built web bundle is read from. Defaults to ../frontend/dist.
# WEB_DIST=/app/web

# Connection pool size. Each in-flight request holds one connection for the
# duration of its transaction, so this is roughly the request concurrency.
DB_POOL_MAX=10
