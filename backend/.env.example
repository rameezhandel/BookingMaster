# Postgres connection
DATABASE_URL=postgres://bookingmaster:bookingmaster@localhost:5432/bookingmaster

# Sign key for owner session tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

PORT=3000
# Origin allowed to call the API (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173
