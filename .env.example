# Host ports for local development.
#
# Copy this to `.env` and change anything that clashes with another project.
# Only the *host* side moves — inside Docker and inside the app the ports are
# fixed, so nothing else has to be kept in step.
#
# Defaults are deliberately not 5432/3000/5173. Those are the first ports every
# other project on your machine takes, and a booking platform is rarely the only
# thing you have running.

# Postgres, as published to your machine by docker compose.
# If you change this, change the port in backend/.env's DATABASE_URL to match.
DB_PORT=5442

# The API.
API_PORT=3010

# The Vite dev server — the address you actually open in a browser.
WEB_PORT=5183
